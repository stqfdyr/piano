# systemd unit for piano. Installed by contrib/install.sh as
# /etc/systemd/system/piano.service; local changes belong in a drop-in
# (systemctl edit piano), for example ReadWritePaths= for an access log outside
# /var/log/piano.
#
# After an upgrade (piano upgrade) the serving process is not systemd's child:
# NotifyAccess=all lets it report itself as the main process, and ExecStop runs
# piano stop, which waits for it and for a predecessor still draining.

[Unit]
Description=piano Emby relay
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=piano
Group=piano
# The pid file is for logrotate, which signals piano to reopen its access log.
ExecStart=/usr/local/bin/piano -c /etc/piano/piano.toml run --pidfile /run/piano/piano.pid
ExecReload=/usr/local/bin/piano -c /etc/piano/piano.toml reload
ExecStop=/usr/local/bin/piano -c /etc/piano/piano.toml stop
# Must exceed server.shutdown_timeout by a few seconds.
TimeoutStopSec=60
Restart=on-failure
RestartSec=2
# A configuration error does not go away by restarting.
RestartPreventExitStatus=2
LimitNOFILE=65536
UMask=0027

RuntimeDirectory=piano
RuntimeDirectoryMode=0750
StateDirectory=piano
StateDirectoryMode=0750
LogsDirectory=piano
LogsDirectoryMode=0750

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
